# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Env files are never committed. A Google Maps browser key in .env tripped the
# Security scan; .env.example documents the variables instead.
# If Lovable re-adds .env, untrack it again (git rm --cached .env).
.env
.env.*
!.env.example

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Agent worktrees created by DeepSeek Harness (local scratch; never commit them)
.agents/worktrees/
