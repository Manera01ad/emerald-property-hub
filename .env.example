# Local development environment for PropWise AI.
#
# Copy to `.env` and fill in the public Supabase values. `.env` is git-ignored.
# Never put a private key in any env file that is committed.


#
# The Supabase values below are PUBLISHABLE keys. They are safe to expose to a
# browser by design; row-level security is what protects the data, not the key.
# Do not put a service-role key, a database migration URL, or the scheduler
# token in this file.

# --- Supabase (from the Supabase project settings) ---
#
# There is NO fallback for these. A build with them unset fails with a clear
# error rather than defaulting to any project, so a misconfigured deploy cannot
# quietly read the wrong database. All four are required.
SUPABASE_PROJECT_ID="lgetjiksdzoqfryelvmv"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID="lgetjiksdzoqfryelvmv"
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Public map display uses keyless Leaflet / OpenStreetMap / Esri tiles.

# --- Server-side only. NEVER commit real values for these. ---
# SUPABASE_SERVICE_ROLE_KEY=        # bypasses all row-level security
# LOVABLE_DB_MIGRATION_URL=         # can alter the production schema
# LOVABLE_CRON_SECRET=              # can trigger the research pipeline

# --- Site address (public). Used for canonical links and the sitemap. ---
VITE_SITE_URL=""

# --- AI assistant (server-side only; unset AI_API_KEY keeps the assistant off
#     and costs nothing). Any OpenAI-compatible endpoint works: the Lovable
#     gateway, or a free tier such as Google Gemini, Groq or OpenRouter. ---
# AI_API_KEY=                      # unset = assistant off (zero cost)
# AI_BASE_URL=                     # e.g. https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=                        # e.g. gemini-2.0-flash
# AI_DAILY_BUDGET_INR=0            # 0 stops all AI spend; raise to enable

# --- Post-migration secret names. The LOVABLE_* names above still work as
#     fallbacks until the deployment bindings are renamed. ---
# CRON_SECRET=                     # research scheduler token
# CRON_SECRET_PREVIOUS=            # accepts the old token during rotation
# DATABASE_MIGRATION_URL=          # Postgres URL, migrations only
