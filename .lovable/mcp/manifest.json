{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://dashpanandamjickoytj.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "emerald-property-hub",
      "version": "0.1.0",
      "title": "Emerald Property Hub"
    },
    "tools": [
      {
        "name": "search_listings",
        "title": "Search public listings",
        "description": "Search publicly visible PropWise property listings by location, type, transaction type and maximum price. A listing is for sale, for rent or for lease.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "location": {
              "description": "Locality text to match, e.g. 'Velachery'.",
              "type": "string"
            },
            "property_type": {
              "description": "Property type, e.g. apartment, plot, house.",
              "type": "string"
            },
            "transaction_type": {
              "description": "What the caller wants: buy, rent or lease. Defaults to buy.",
              "type": "string",
              "enum": [
                "buy",
                "rent",
                "lease"
              ]
            },
            "max_price": {
              "description": "Maximum price in rupees. For rent or lease this is the monthly figure.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "limit": {
              "description": "Max results (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_listing",
        "title": "Get listing details",
        "description": "Get full details of one publicly visible PropWise listing by its id. The result says whether it is for sale, rent or lease.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Listing id from search_listings."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_my_research",
        "title": "Get my property research",
        "description": "Get the signed-in user's saved buyer/renter preferences and their saved reports.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
